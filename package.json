{
  "name": "daily-brief",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "pipeline",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck -w @daily-brief/web",
    "schema:emit": "tsx packages/schema/scripts/emit-json-schema.ts",
    "brief:context": "tsx pipeline/context/cli.ts",
    "brief:collect": "NODE_USE_ENV_PROXY=1 tsx pipeline/collect/cli.ts",
    "brief:newsletters": "tsx pipeline/newsletters/cli.ts",
    "brief:verify": "tsx pipeline/verify/cli.ts",
    "brief:audio": "tsx pipeline/audio/cli.ts",
    "brief:render": "tsx pipeline/render/cli.ts",
    "brief:publish": "tsx pipeline/publish/cli.ts",
    "brief:finish": "tsx pipeline/run/finish-cli.ts",
    "brief:notify": "tsx pipeline/run/notify-cli.ts",
    "env:check": "tsx pipeline/run/env-check-cli.ts",
    "audio:samples": "tsx pipeline/audio/samples-cli.ts",
    "check:thenewsapi": "tsx pipeline/collect/check-thenewsapi.ts",
    "maps:preview": "tsx packages/maps/scripts/preview.ts",
    "web:dev": "npm run dev -w @daily-brief/web",
    "web:build": "npm run build -w @daily-brief/web",
    "web:e2e": "playwright test -c apps/web/playwright.config.ts",
    "web:check-bundle": "tsx apps/web/scripts/check-bundle.ts",
    "web:icons": "tsx apps/web/scripts/make-icons.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@types/node": "^22.10.0",
    "@types/pngjs": "^6.0.5",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
